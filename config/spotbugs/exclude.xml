<?xml version="1.0" encoding="UTF-8"?>
<!-- SpotBugs filter file with correct namespace and schema location -->
<FindBugsFilter
        xmlns="https://findbugs.sourceforge.net/filter/3.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://findbugs.sourceforge.net/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/4.8.4/spotbugs/etc/findbugsfilter.xsd">
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Bug pattern="UPM_UNCALLED_PRIVATE_METHOD"/>
    </Match>
    <Match>
        <Class name="com.acme.kms.entity.Kasse_"/>
    </Match>
    <Match>
        <Class name="com.acme.kms.entity.Kassierer_"/>
    </Match>
    <Match>
        <Class name="com.acme.kms.entity.KassenBon_" />
    </Match>
</FindBugsFilter>
